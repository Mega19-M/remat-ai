# Copy to .env (never commit .env). Contains NO secrets: AWS credentials come from `aws configure`.
# Local server default; for the hosted endpoint use your provider URL.
REMAT_DECIDER_URL=http://127.0.0.1:8000
# Hosted endpoint key (optional; keep the real value only in your private .env).
DECIDER_API_KEY=
# Choose a model id you have access to (run: python scripts/check_bedrock.py)
REMAT_BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
